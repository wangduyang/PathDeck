<Window x:Class="TaskGlass.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TaskGlass" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PathDeck · 选择颜色" Width="560" Height="780" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14" Foreground="#F4F6F5" Icon="Assets/TaskGlass.ico">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="72" ResizeBorderThickness="0" CornerRadius="28" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="Background" Value="{DynamicResource SettingsSurfaceBrush}"/><Setter Property="BorderBrush" Value="#32FFFFFF"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="44"/><Setter Property="CaretBrush" Value="{DynamicResource SettingsAccent}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" CornerRadius="12" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></Window.Resources>
    <Grid x:Name="Layers">
        <Border x:Name="BackdropMaterial" IsHitTestVisible="False"><local:BackdropImage x:Name="Backdrop" Stretch="Fill" IsHitTestVisible="False"><local:BackdropImage.Effect><BlurEffect x:Name="BackdropBlur" Radius="36" RenderingBias="Performance"/></local:BackdropImage.Effect></local:BackdropImage></Border>
        <Border x:Name="Tint" CornerRadius="28" BorderBrush="#66707876" BorderThickness="1" Background="#293234">
            <Grid Margin="26,18,26,24"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="选择颜色" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ScopeText" FontSize="12" Foreground="{DynamicResource SettingsMutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="×" Width="44" Height="44" Padding="0" FontSize="23" Style="{StaticResource SettingsQuietButton}" Click="Cancel" AutomationProperties.Name="关闭颜色面板" shell:WindowChrome.IsHitTestVisibleInChrome="True"/></Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,16,4,12">
                    <Grid x:Name="ColorField" Height="220" Background="Red" MouseLeftButtonDown="SelectField" MouseMove="MoveField" MouseLeftButtonUp="ReleaseField" Cursor="Cross" AutomationProperties.Name="饱和度与明度选色区域">
                        <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Canvas IsHitTestVisible="False"><Ellipse x:Name="Marker" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="Transparent"/><Ellipse x:Name="MarkerOutline" Width="20" Height="20" Stroke="#99000000" StrokeThickness="1" Fill="Transparent"/></Canvas>
                    </Grid>
                    <DockPanel Margin="0,12,0,0"><TextBlock Text="色相"/><TextBlock x:Name="HueText" HorizontalAlignment="Right" Foreground="{DynamicResource SettingsMutedBrush}"/></DockPanel>
                    <Slider x:Name="HueSlider" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" ValueChanged="ChangeHue" AutomationProperties.Name="颜色色相"/>
                    <UniformGrid Columns="8" Margin="-3,0,-3,12">
                        <Button Background="#E67878" Tag="#E67878" Click="Preset" Margin="3,0" Padding="0" AutomationProperties.Name="珊瑚红"/><Button Background="#E7B674" Tag="#E7B674" Click="Preset" Margin="3,0" Padding="0" AutomationProperties.Name="暖橙"/><Button Background="#E1D780" Tag="#E1D780" Click="Preset" Margin="3,0" Padding="0" AutomationProperties.Name="浅黄"/><Button Background="#88CDA8" Tag="#88CDA8" Click="Preset" Margin="3,0" Padding="0" AutomationProperties.Name="薄荷绿"/><Button Background="#78C8D3" Tag="#78C8D3" Click="Preset" Margin="3,0" Padding="0" AutomationProperties.Name="湖蓝"/><Button Background="#7F9DDB" Tag="#7F9DDB" Click="Preset" Margin="3,0" Padding="0" AutomationProperties.Name="雾蓝"/><Button Background="#B796D8" Tag="#B796D8" Click="Preset" Margin="3,0" Padding="0" AutomationProperties.Name="淡紫"/><Button Background="#242B2D" Tag="#242B2D" Click="Preset" Margin="3,0" Padding="0" AutomationProperties.Name="烟灰"/>
                    </UniformGrid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="HEX" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="HexInput" MaxLength="7" TextChanged="ChangeHex" AutomationProperties.Name="十六进制颜色"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="原色 / 新颜色" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="12" Margin="0,0,0,6"/><Grid Height="44"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="OriginalSwatch" CornerRadius="12,0,0,12"/><Border x:Name="NewSwatch" Grid.Column="1" CornerRadius="0,12,12,0"/></Grid></StackPanel></Grid>
                    <UniformGrid Columns="3" Margin="-4,12,-4,0"><StackPanel Margin="4,0"><TextBlock Text="红 R" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="RedInput" MaxLength="3" TextChanged="ChangeRgb" AutomationProperties.Name="红色通道"/></StackPanel><StackPanel Margin="4,0"><TextBlock Text="绿 G" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="GreenInput" MaxLength="3" TextChanged="ChangeRgb" AutomationProperties.Name="绿色通道"/></StackPanel><StackPanel Margin="4,0"><TextBlock Text="蓝 B" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="BlueInput" MaxLength="3" TextChanged="ChangeRgb" AutomationProperties.Name="蓝色通道"/></StackPanel></UniformGrid>
                </StackPanel></ScrollViewer>
                <StackPanel Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource SettingsErrorBrush}" FontSize="12" Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="取消" Margin="0,0,6,0" Click="Cancel" IsCancel="True"/><Button x:Name="ApplyButton" Grid.Column="1" Content="应用颜色" Style="{StaticResource SettingsPrimaryButton}" Margin="6,0,0,0" Click="Apply" IsDefault="True"/></Grid></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
