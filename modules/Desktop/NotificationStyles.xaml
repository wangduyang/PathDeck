<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="NoticeCardFocus" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="-5" Stroke="#4D7463" StrokeThickness="2" RadiusX="16" RadiusY="16"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NoticeButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource NoticeCloseTextBrush}"/><Setter Property="Background" Value="{DynamicResource NoticeCloseBackground}"/>
        <Setter Property="Padding" Value="6,2"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource NoticeCloseHoverBackground}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource NoticeClosePressedBackground}"/><Setter Property="Foreground" Value="{DynamicResource NoticeClosePressedTextBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource NoticeCloseFocusBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
