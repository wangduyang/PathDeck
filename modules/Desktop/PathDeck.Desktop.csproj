<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PathDeck.Desktop</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\TaskGlass.ico" />
    <Resource Include="Assets\GlassMaterial.ps" />
    <EmbeddedResource Include="Assets\StartMenu\PathDeck.json" LogicalName="TaskGlass.StartMenu.PathDeck.json" />
    <Compile Remove="tests\**;native\**;third-party\**;Runtime\**" />
    <Page Remove="tests\**;native\**;third-party\**;Runtime\**" />
    <Content Include="Runtime\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="Modules\Desktop\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
