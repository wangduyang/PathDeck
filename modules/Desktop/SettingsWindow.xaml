<Window x:Class="TaskGlass.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TaskGlass" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PathDeck · 桌面与任务栏设置" Icon="Assets/TaskGlass.ico" Width="960" Height="760" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" Background="Transparent"
        Foreground="#F4F6F5" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14" Closing="HidePanel">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="82" ResizeBorderThickness="0" CornerRadius="30" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="BackdropLayers">
    <Border x:Name="SettingsMaterialLayer" IsHitTestVisible="False">
    <local:BackdropImage x:Name="SettingsBackdrop" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed">
        <local:BackdropImage.Effect><BlurEffect x:Name="SettingsBlurEffect" Radius="36" RenderingBias="Performance"/></local:BackdropImage.Effect>
    </local:BackdropImage>
    </Border>
    <Border x:Name="GlassTint" CornerRadius="30" BorderThickness="1" BorderBrush="#66707876">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30383A" Offset="0"/><GradientStop Color="#202729" Offset=".5"/><GradientStop Color="#262F30" Offset="1"/></LinearGradientBrush></Border.Background>
        <Grid Margin="30,20,30,22">
            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <Image Source="Assets/TaskGlass.ico" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="PathDeck 图标"/>
                <TextBlock Grid.Column="1" Text="PathDeck" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#153CD8AB" CornerRadius="12" Padding="10,5" Margin="14,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="RuntimeStatusText" FontSize="11" Foreground="{DynamicResource SettingsAccent}" TextWrapping="Wrap"/>
                </Border>
                <Button Grid.Column="3" Content="×" FontSize="23" Padding="0" Width="44" Height="44" VerticalAlignment="Center"
                        Style="{StaticResource SettingsQuietButton}" Click="ClosePanel" ToolTip="关闭面板" AutomationProperties.Name="关闭设置面板" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,8,20,0">
                <Grid Margin="0,0,0,16"><TextBox x:Name="SettingsSearch" Height="44" ToolTip="搜索设置" AutomationProperties.Name="搜索设置" TextChanged="SearchSettings"/>
                    <TextBlock Text="⌕  搜索设置" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SettingsMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SettingsSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid>
                <ListBox x:Name="SectionNavigation" SelectionChanged="SelectSection" AutomationProperties.Name="设置分类"/>
                <TextBlock x:Name="BuildVersionText" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SettingsMutedBrush}" Margin="12,24,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                <StackPanel x:Name="PageContent" Margin="0,4,8,4">
                    <TextBlock x:Name="PageTitle" Text="外观与动画" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="让每一次展开与切换都自然" Style="{StaticResource SettingsMuted}" Margin="0,8,0,16"/>
                    <Border Tag="外观与动画" Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="玻璃外观" Style="{StaticResource SettingsSectionTitle}"/>
                            <DockPanel Margin="0,12,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" Foreground="{DynamicResource SettingsAccent}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="背景不透明度"/></DockPanel>
                            <Slider x:Name="OpacitySlider" Minimum="10" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="ChangeAppearance" AutomationProperties.Name="背景不透明度"/>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0} px}" Foreground="{DynamicResource SettingsAccent}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="圆角半径"/></DockPanel>
                            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4" ValueChanged="ChangeAppearance" AutomationProperties.Name="圆角半径"/>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=BlurSlider, StringFormat={}{0:0}%}" Foreground="{DynamicResource SettingsAccent}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="玻璃模糊强度"/></DockPanel>
                            <Slider x:Name="BlurSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="ChangeAppearance" AutomationProperties.Name="玻璃模糊强度" ToolTip="调节文件管理、设置面板、通知、任务栏、开始菜单和搜索的背景模糊；0 为关闭模糊"/>
                            <TextBlock Text="统一配色" Margin="0,12,0,0"/>
                            <UniformGrid Columns="1" Margin="-4,8,-4,0">
                                <Button x:Name="TaskbarColorButton" Tag="TaskbarColor" Click="ChooseColor" Padding="8,6" Margin="4,0" MinHeight="56" AutomationProperties.Name="选择统一界面颜色">
                                    <StackPanel Orientation="Horizontal"><Border x:Name="TaskbarSwatch" Width="18" Height="18" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center" BorderBrush="#55FFFFFF" BorderThickness="1"/><StackPanel><TextBlock Text="文件管理、任务栏、通知与桌面分区" FontSize="13"/><TextBlock x:Name="TaskbarColorText" FontSize="11"/></StackPanel></StackPanel>
                                </Button>


                            </UniformGrid>
                            <TextBlock Text="通知和桌面分区跟随统一颜色与透明度。" Style="{StaticResource SettingsMuted}" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Tag="外观与动画" Style="{StaticResource SettingsCard}" Padding="22,10" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox x:Name="StartMenuCheck" Content="开始与搜索 · PathDeck 玻璃" Checked="SetStartMenu" Unchecked="SetStartMenu" AutomationProperties.Name="启用 PathDeck 开始菜单样式"/>
                            <TextBlock x:Name="StartMenuStatusText" Style="{StaticResource SettingsMuted}" FontSize="12" Margin="0,4,0,0" ToolTip="跟随“通用界面与任务栏”颜色和玻璃模糊强度，保留原生菜单功能与原始应用图标。" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                    <Border Tag="桌面分区" Style="{StaticResource SettingsCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="桌面分区" Style="{StaticResource SettingsSectionTitle}"/><TextBlock Text="按现有摆放自动划区" Style="{StaticResource SettingsMuted}" Margin="0,8,12,0"/></StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="DesktopCountText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="DesktopIconCountText" Style="{StaticResource SettingsMuted}" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock x:Name="DesktopStatusText" Style="{StaticResource SettingsMuted}" FontSize="12" Margin="0,12,0,0"/>
                            <TextBlock Text="超过两排的分区默认只显示第一排。点击空白处或箭头展开；鼠标离开 3 秒后收起。"
                                       Style="{StaticResource SettingsMuted}" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Tag="通知" Style="{StaticResource SettingsCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <Expander Foreground="{DynamicResource SettingsMutedBrush}" HorizontalContentAlignment="Stretch" ToolTip="展开查看消息来源状态" AutomationProperties.Name="消息通知来源状态">
                                <Expander.Header><StackPanel Orientation="Horizontal" MinHeight="44"><TextBlock Text="消息通知" Style="{StaticResource SettingsSectionTitle}" Foreground="{DynamicResource SettingsTextBrush}" VerticalAlignment="Center"/><TextBlock Text="来源状态" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                                <TextBlock x:Name="NotificationStatusText" Style="{StaticResource SettingsMuted}" FontSize="12" LineHeight="20" Margin="20,6,0,0"/>
                            </Expander>
                            <TextBlock x:Name="NotificationSummaryText" Foreground="{DynamicResource SettingsAccent}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <CheckBox x:Name="WeChatSummaryCheck" Content="微信未读摘要" Click="SetWeChatSummary" AutomationProperties.Name="接收微信会话列表中的新增未读摘要"/>
                            <TextBlock Text="未处理提醒会保留，打开对应软件后收起。" Style="{StaticResource SettingsMuted}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Tag="备份与关于" Style="{StaticResource SettingsCard}" Padding="22,10" Margin="0,16,0,0">
                        <CheckBox x:Name="StartupCheck" Content="登录后自动运行" Click="SetStartup" AutomationProperties.Name="登录 Windows 后自动运行"/>
                    </Border>
                    <TextBlock Text="关闭后仍在后台运行，双击托盘图标重新打开。" Style="{StaticResource SettingsMuted}" FontSize="12" Margin="2,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                <TextBlock x:Name="StatusText" Foreground="#FFD1BD" TextWrapping="Wrap" Margin="2,0,2,10" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="测试通知" Style="{StaticResource SettingsPrimaryButton}" MinWidth="128" Click="TestNotification"/>
                    <Button Grid.Column="1" Content="恢复外观并退出" Style="{StaticResource SettingsQuietButton}" HorizontalAlignment="Center" Margin="8,0" Click="RestoreAndExit"/>
                    <Button Grid.Column="2" Content="关闭面板" MinWidth="112" Click="ClosePanel"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
