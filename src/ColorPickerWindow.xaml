<Window x:Class="QuickFileDesk.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画笔颜色" Width="460" Style="{StaticResource DialogWindow}" Loaded="FocusHex">
    <StackPanel Margin="16">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Grid Height="154">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ColorPlane" Background="Transparent" Margin="0,0,10,0" Cursor="Cross"
                          MouseLeftButtonDown="StartColorDrag" MouseMove="MoveColorDrag"
                          MouseLeftButtonUp="EndColorDrag" SizeChanged="PickerResized"
                          AutomationProperties.Name="饱和度与明度">
                        <Border x:Name="PlaneColor" CornerRadius="8" IsHitTestVisible="False"/>
                        <Border CornerRadius="8" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="8" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="PlaneMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity=".95"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <Grid x:Name="HueStrip" Grid.Column="1" Background="Transparent" Cursor="Cross"
                          MouseLeftButtonDown="StartColorDrag" MouseMove="MoveColorDrag"
                          MouseLeftButtonUp="EndColorDrag" SizeChanged="PickerResized" AutomationProperties.Name="色相">
                        <Border CornerRadius="7" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset=".166667"/>
                                    <GradientStop Color="#00FF00" Offset=".333333"/>
                                    <GradientStop Color="#00FFFF" Offset=".5"/>
                                    <GradientStop Color="#0000FF" Offset=".666667"/>
                                    <GradientStop Color="#FF00FF" Offset=".833333"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="HueMarker" Height="7" Width="28" CornerRadius="3" BorderBrush="White" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity=".95"/>
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewColor" Height="34" VerticalAlignment="Bottom" Margin="0,0,9,0"
                            CornerRadius="8" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                            AutomationProperties.Name="当前颜色预览"/>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="HEX" Foreground="{DynamicResource Muted}" Margin="1,0,0,4"/>
                        <TextBox x:Name="HexInput" Style="{StaticResource DialogInput}" MaxLength="7"
                                 AutomationProperties.Name="HEX 颜色" TextChanged="ColorInputChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="R" Foreground="{DynamicResource Muted}" Margin="1,0,0,4"/>
                        <TextBox x:Name="RedInput" Style="{StaticResource DialogInput}" MaxLength="3"
                                 AutomationProperties.Name="红色分量" TextChanged="ColorInputChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="G" Foreground="{DynamicResource Muted}" Margin="1,0,0,4"/>
                        <TextBox x:Name="GreenInput" Style="{StaticResource DialogInput}" MaxLength="3"
                                 AutomationProperties.Name="绿色分量" TextChanged="ColorInputChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="B" Foreground="{DynamicResource Muted}" Margin="1,0,0,4"/>
                        <TextBox x:Name="BlueInput" Style="{StaticResource DialogInput}" MaxLength="3"
                                 AutomationProperties.Name="蓝色分量" TextChanged="ColorInputChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="InputError" Text="请输入六位 HEX 或 0–255 的 RGB 数值。"
                           Foreground="{DynamicResource ErrorText}" Margin="1,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource DialogCard}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="常用颜色" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel x:Name="PresetSwatches"/>
                <StackPanel x:Name="RecentSection" Margin="0,9,0,0">
                    <TextBlock Text="最近使用" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="RecentSwatches"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogButton}" MinWidth="74" Margin="0,0,8,0"/>
            <Button x:Name="AcceptButton" Content="应用颜色" IsDefault="True" Style="{StaticResource DialogPrimaryButton}" Click="AcceptColor"/>
        </StackPanel>
    </StackPanel>
</Window>
