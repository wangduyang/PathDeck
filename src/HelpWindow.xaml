<Window x:Class="QuickFileDesk.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickFileDesk"
        Title="PathDeck 使用说明" Width="960" Height="720" MinWidth="780" MinHeight="540"
        Style="{StaticResource DialogWindow}" SizeToContent="Manual" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <local:LiquidGlassBorder x:Name="Surface" CornerRadius="14" Background="Transparent"
                                                 Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </local:LiquidGlassBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="PathDeck / 使用说明" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="从找文件，到复核图像" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="按场景选择左侧章节，跟着步骤完成操作。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <local:LiquidGlassBorder Background="{DynamicResource GlassSurface}" BorderBrush="{DynamicResource GlassEdge}"
                                     BorderThickness="1" CornerRadius="22" Padding="8">
                <ListBox x:Name="Topics" Background="Transparent" BorderThickness="0" DisplayMemberPath="Title"
                         SelectionChanged="SelectTopic" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="使用说明目录"/>
            </local:LiquidGlassBorder>
            <ScrollViewer x:Name="ArticleScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,3,10,0">
                    <TextBlock x:Name="TopicTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TopicSummary" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,18"/>
                    <local:LiquidGlassBorder Background="{DynamicResource GlassSurface}" BorderBrush="{DynamicResource GlassEdge}"
                                             BorderThickness="1" CornerRadius="20" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="ToggleDemoButton" DockPanel.Dock="Right" Content="收起配图" Click="ToggleDemo"
                                        Style="{StaticResource DialogButton}" Padding="10,3" MinHeight="28"/>
                                <TextBlock Text="操作演示" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="DemoContent">
                                <Image x:Name="DemoImage" Height="210" Stretch="Uniform" Cursor="Hand"
                                       RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonUp="OpenDemoImage"
                                       ToolTip="点击图片放大查看"/>
                                <TextBlock x:Name="DemoCaption" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,5"/>
                                <TextBlock Text="真实界面 · 示例数据 · 点击图片可放大" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                <DockPanel Margin="0,10,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="PreviousFrameButton" Content="←" Click="PreviousFrame" Style="{StaticResource DialogButton}"
                                                AutomationProperties.Name="上一帧" MinHeight="30" Padding="10,3"/>
                                        <TextBlock x:Name="DemoPosition" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource Muted}"/>
                                        <Button x:Name="NextFrameButton" Content="→" Click="NextFrame" Style="{StaticResource DialogButton}"
                                                AutomationProperties.Name="下一帧" MinHeight="30" Padding="10,3"/>
                                    </StackPanel>
                                    <Button x:Name="PlayDemoButton" Content="播放演示" Click="PlayDemo" Style="{StaticResource DialogPrimaryButton}"
                                            HorizontalAlignment="Left" MinHeight="30" Padding="12,3"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </local:LiquidGlassBorder>
                    <ItemsControl x:Name="Steps">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:LiquidGlassBorder Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}"
                                                         BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Accent}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="23"/>
                                    </Grid>
                                </local:LiquidGlassBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="NotePanel" Background="{DynamicResource Selected}" CornerRadius="16" Padding="16" Margin="0,4,0,8">
                        <StackPanel>
                            <TextBlock Text="使用提示" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TopicNote" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button Content="关闭说明" IsCancel="True" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" MinWidth="94"/>
            <TextBlock Text="说明随软件提供，离线也能查看。" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>