<Window x:Class="QuickFileDesk.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickFileDesk"
        Width="1000" Height="780" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Loaded="LoadImage" Closing="CheckEditsBeforeClose" Closed="CancelLoad" PreviewKeyDown="HandleKeys"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ImageToolButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}" CornerRadius="8"
                                Background="{DynamicResource ButtonSurface}" BorderBrush="{DynamicResource ButtonEdge}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusEdge}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="ViewerContent" Focusable="True" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                <RadioButton Style="{StaticResource ImageToolButton}" GroupName="ImageTools" Content="手形" Tag="Pan"
                             IsChecked="True" Checked="ToolChecked" ToolTip="拖动查看。按住鼠标中键也能平移。"/>
                <RadioButton Style="{StaticResource ImageToolButton}" GroupName="ImageTools" Content="画笔" Tag="Pen" Checked="ToolChecked"/>
                <RadioButton Style="{StaticResource ImageToolButton}" GroupName="ImageTools" Content="直线" Tag="Line" Checked="ToolChecked"/>
                <RadioButton Style="{StaticResource ImageToolButton}" GroupName="ImageTools" Content="箭头" Tag="Arrow" Checked="ToolChecked"/>
                <RadioButton Style="{StaticResource ImageToolButton}" GroupName="ImageTools" Content="矩形" Tag="Rectangle" Checked="ToolChecked"/>
                <RadioButton Style="{StaticResource ImageToolButton}" GroupName="ImageTools" Content="椭圆" Tag="Ellipse" Checked="ToolChecked"/>
                <RadioButton Style="{StaticResource ImageToolButton}" GroupName="ImageTools" Content="测距" Tag="Measure" Checked="ToolChecked"
                             ToolTip="拖动测量两点的直线距离和横纵像素差"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                <Button Click="ChooseColorClick" AutomationProperties.Name="选择颜色" ToolTip="自定义 RGB 颜色" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ColorSwatch" Width="14" Height="14" CornerRadius="4" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource Edge}" BorderThickness="1"/>
                        <TextBlock Text="颜色"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StrokeButton" Content="线宽 3 px  ⌄" MinWidth="98" Click="OpenStrokeMenu"
                        AutomationProperties.Name="线宽 3 像素" ToolTip="设置笔画粗细，单位是原图像素。">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="StrokeMenu" Placement="Bottom">
                            <MenuItem Header="1 px" Tag="1" IsCheckable="True" Click="SelectStroke"/>
                            <MenuItem Header="3 px" Tag="3" IsCheckable="True" IsChecked="True" Click="SelectStroke"/>
                            <MenuItem Header="6 px" Tag="6" IsCheckable="True" Click="SelectStroke"/>
                            <MenuItem Header="12 px" Tag="12" IsCheckable="True" Click="SelectStroke"/>
                            <MenuItem Header="24 px" Tag="24" IsCheckable="True" Click="SelectStroke"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="UndoButton" Content="撤销" Click="UndoClick" ToolTip="Ctrl+Z" Margin="0,0,4,0"/>
                <Button x:Name="RedoButton" Content="重做" Click="RedoClick" ToolTip="Ctrl+Y" Margin="0,0,4,0"/>
                <Button x:Name="SaveButton" Content="另存标注" Click="SaveClick" ToolTip="另存为 PNG（Ctrl+S）"/>
            </StackPanel>
        </WrapPanel>
        <Border x:Name="MaskControls" Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}"
                BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="MaskStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                <WrapPanel x:Name="MaskOptions" Margin="0,6,0,0">
                    <TextBlock Text="标注不透明度" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="MaskOpacity" Minimum="0" Maximum="100" Value="50" Width="128" SmallChange="1" LargeChange="10"
                            IsMoveToPointEnabled="True" VerticalAlignment="Center" ValueChanged="MaskOpacityChanged"
                            Foreground="{DynamicResource Accent}" AutomationProperties.Name="标注不透明度"
                            ToolTip="0% 只显示原图，100% 实色叠加"/>
                    <TextBlock Width="44" Margin="6,0,4,0" VerticalAlignment="Center"
                               Text="{Binding Value, ElementName=MaskOpacity, StringFormat={}{0:0}%}"/>
                    <Button x:Name="MaskClassButton" Content="显示类别  ⌄" Click="OpenMaskClassMenu">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MaskClassMenu" Placement="Bottom"/>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Field}" CornerRadius="10" Padding="8">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开方式…" Click="OpenWithClick"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviousButton" Content="‹" FontSize="20" Width="44" Height="44"
                        Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="上一张（←）" AutomationProperties.Name="上一张" Click="PreviousClick"/>
                <Grid Grid.Column="1" ClipToBounds="True">
                    <local:ImageEditorCanvas x:Name="Editor"/>
                    <TextBlock x:Name="ImageHint" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}"/>
                </Grid>
                <Button x:Name="NextButton" Grid.Column="2" Content="›" FontSize="20" Width="44" Height="44"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="下一张（→）" AutomationProperties.Name="下一张" Click="NextClick"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ImageStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Muted}"/>
            <TextBlock x:Name="ImagePosition" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomStatus" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
                <Button x:Name="FitButton" Content="适应" Click="FitClick" Margin="0,0,4,0" Padding="7,4"/>
                <Button x:Name="ActualSizeButton" Content="1:1" Click="ActualSizeClick" ToolTip="一个图像像素对应一个屏幕像素" Padding="7,4"/>
            </StackPanel>
            <TextBlock x:Name="EditStatus" Grid.Row="1" Grid.ColumnSpan="3" MinHeight="18" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/>
        </Grid>
    </Grid>
</Window>
