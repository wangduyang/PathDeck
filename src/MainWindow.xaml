                    <Border x:Name="FileListPane" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <ListView x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
