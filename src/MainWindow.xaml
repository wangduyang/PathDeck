                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=QuickResults}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
