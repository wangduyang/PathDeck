                                                        <DataTrigger Binding="{Binding Text, ElementName=QuickQuery}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                        <TextBlock x:Name="QuickIndexScopeLabel" Margin="1,7,0,0" FontSize="12"
                                   Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
