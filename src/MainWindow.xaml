                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Chip" CornerRadius="8" Padding="10,5" BorderThickness="1"
                                                    BorderBrush="{DynamicResource Edge}" Background="{DynamicResource Panel}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ButtonHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Selected}"/>
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton x:Name="QuickAllKinds" Content="全部" IsChecked="True" Checked="QuickKindChanged"/>
                        <RadioButton x:Name="QuickFilesOnly" Content="文件" Checked="QuickKindChanged"/>
                        <RadioButton x:Name="QuickFoldersOnly" Content="文件夹" Checked="QuickKindChanged"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                        CornerRadius="12" Padding="4">
                    <ListView x:Name="QuickResults" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="跨盘搜索结果" MouseDoubleClick="OpenQuickDoubleClick" KeyDown="QuickResultKey"
                              SizeChanged="QuickResultsResized">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn x:Name="QuickNameColumn" Header="名称" Width="250">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2,0,0,0" ToolTip="{Binding FullPath}">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="QuickFolderColumn" Header="所在文件夹" Width="310">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="修改日期" Width="136" DisplayMemberBinding="{Binding UpdatedText}"/>
                                <GridViewColumn Header="大小" Width="78" DisplayMemberBinding="{Binding Size}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <DockPanel Grid.Row="3" Margin="2,7,2,0" MinHeight="25">
                    <Button x:Name="QuickMore" DockPanel.Dock="Right" Content="加载更多" Visibility="Collapsed" Click="QuickMoreClick"/>
                    <TextBlock x:Name="QuickStatus" Text="输入文件名开始搜索。"
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/>
                <StackPanel x:Name="ArchiveProgressPanel" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <ProgressBar x:Name="ArchiveProgressBar" Width="116" Height="6" IsIndeterminate="False"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Background="{DynamicResource GaugeTrack}"
                                 BorderThickness="0" AutomationProperties.Name="归档进度"/>
                    <Button x:Name="CancelArchiveButton" Content="取消" Click="CancelArchiveClick" MinWidth="48"
                            Margin="7,0,0,0" Padding="8,2" Style="{StaticResource ToolbarButton}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

