                                  MouseDoubleClick="OpenDoubleClick" PreviewMouseRightButtonDown="SelectRightClick"
                                  ContextMenuOpening="PrepareMenu" GridViewColumnHeader.Click="SortFiles" SizeChanged="FileListResized"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" AllowDrop="True" DragOver="FileDragOver" Drop="FileDrop"
                                  PreviewMouseLeftButtonDown="BeginDrag" PreviewMouseMove="DragFiles">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="270">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3,0,3,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="{DynamicResource FileIconSize}" Height="{DynamicResource FileIconSize}" Margin="0,0,7,0"
                                                          IsHitTestVisible="False">
                                                        <local:FileThumbnail x:Name="Thumbnail" Active="{DynamicResource ShowFileThumbnails}" Stretch="Uniform"/>
                                                        <Border BorderThickness="1" CornerRadius="3">
                                                            <Border.BorderBrush><SolidColorBrush Color="{Binding IconColor}"/></Border.BorderBrush>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsShortcut}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Viewbox>
                                                            <Viewbox.Style>
                                                                <Style TargetType="Viewbox">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Viewbox.Style>
                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileIcon}"/>
                                                        </Viewbox>
                                                    </Grid>
                                                    <Ellipse x:Name="ColorDot" Grid.Column="1" Fill="{Binding TagColor}" Width="9" Height="9"
                                                             VerticalAlignment="Center" Margin="0,0,7,0" ToolTip="颜色标签"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" ToolTip="{Binding FullPath}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               PreviewMouseLeftButtonDown="FileNamePressed" PreviewMouseLeftButtonUp="FileNameReleased"/>
                                                    <TextBox Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center" Padding="3,1"
                                                             MinWidth="36" AutomationProperties.Name="重命名"
                                                             KeyDown="InlineNameKey" LostKeyboardFocus="InlineNameLostFocus" Unloaded="InlineNameUnloaded"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding TagColor}" Value="{x:Null}">
                                                        <Setter TargetName="ColorDot" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="修改日期" Width="133" DisplayMemberBinding="{Binding UpdatedText}"/>
                                    <GridViewColumn Header="{x:Static local:MainWindow.ModifiedAgeHeader}" Width="102">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="7,2" MinWidth="76" HorizontalAlignment="Left">
                                                    <Border.DataContext>
                                                        <MultiBinding Converter="{StaticResource FileAgeConverter}" Mode="OneWay">
                                                            <Binding Path="Updated"/>
                                                            <Binding Path="FileAgeNow" RelativeSource="{RelativeSource AncestorType={x:Type local:MainWindow}}"/>
                                                        </MultiBinding>
                                                    </Border.DataContext>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Field}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Band}" Value="Recent">
                                                                    <Setter Property="Background" Value="{DynamicResource AgeRecentBackground}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AgeRecentText}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Band}" Value="Day">
                                                                    <Setter Property="Background" Value="{DynamicResource AgeDayBackground}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AgeDayText}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Band}" Value="Week">
                                                                    <Setter Property="Background" Value="{DynamicResource AgeWeekBackground}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AgeWeekText}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Band}" Value="Month">
                                                                    <Setter Property="Background" Value="{DynamicResource AgeMonthBackground}"/>
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AgeMonthText}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="类型" Width="82" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="大小" Width="85" DisplayMemberBinding="{Binding Size}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <Border x:Name="DrivePage" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}"
                            BorderThickness="1" CornerRadius="10" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="设备和驱动器" Foreground="{DynamicResource Muted}"
                                           FontWeight="SemiBold" Margin="4,0,0,8"/>
                                <ListBox x:Name="DriveList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                                         AutomationProperties.Name="设备和驱动器" MouseDoubleClick="OpenDriveDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="3"/>
                                            <Setter Property="Background" Value="{DynamicResource OverviewTile}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Tile" Background="{TemplateBinding Background}" CornerRadius="8"
                                                                BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="12,9">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Hover}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Selected}"/>
                                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource FocusEdge}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Width="172" MinHeight="52" ToolTip="{Binding Path}">
                                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CapacityText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="OverviewPinsSection" Visibility="Collapsed" Margin="0,18,0,0">
                                    <TextBlock Text="经常访问" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="4,0,0,8"/>
                                    <WrapPanel x:Name="OverviewPinsPanel" ItemWidth="218" Margin="3,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="10" Cursor="SizeWE" Visibility="Collapsed"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="12"
                                  ToolTip="拖动调整文件列表和预览的宽度"
                                  AutomationProperties.Name="调整文件列表和预览的宽度" FocusVisualStyle="{x:Null}">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Border x:Name="Grip" Width="3" Height="36" CornerRadius="1.5" Background="{DynamicResource Grip}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <Border x:Name="PreviewPane" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource Panel}"
                            CornerRadius="10" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Height="23" Margin="0,0,0,8">
                                <Button x:Name="PreviewZoomButton" DockPanel.Dock="Right" Content="适应" Visibility="Collapsed"
                                        Style="{StaticResource ToolbarButton}" Padding="5,2" FontSize="11" Click="ResetPreviewClick"
                                        ToolTip="还原适应窗口。滚轮缩放，拖动查看"/>
                                <TextBlock Text="预览" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Grid.Row="1" Background="{DynamicResource Field}" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <ScrollViewer x:Name="PreviewViewport" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                                  Focusable="False" SizeChanged="PreviewViewportResized" PreviewMouseWheel="PreviewWheel"
                                                  PreviewMouseLeftButtonDown="StartPreviewDrag" PreviewMouseLeftButtonUp="StopPreviewDrag"
                                                  PreviewMouseMove="MovePreviewDrag" LostMouseCapture="PreviewDragCaptureLost"
                                                  MouseLeave="LeavePreview" ScrollChanged="PreviewGeometryChanged">
                                        <Grid x:Name="PreviewCanvas" Background="Transparent">
                                            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   SizeChanged="PreviewGeometryChanged"/>
                                        </Grid>
                                    </ScrollViewer>
                                    <TextBlock x:Name="PreviewHint" Text="正在加载图片…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"
                                               TextWrapping="Wrap" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock x:Name="PreviewName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewDetails" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <StackPanel x:Name="PreviewPixelStatus" Visibility="Hidden" Height="34" Margin="0,6,0,0">
                                    <TextBlock x:Name="PreviewCoordinates" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="PreviewPixelValue" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="QuickSearchPage" Grid.Column="1" Margin="14,12,14,12" Visibility="Collapsed">
