                        <Button Content="复制" Click="CopyClick" Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"/>
                        <Button Content="粘贴" Click="PasteClick" Style="{StaticResource ToolbarButton}" Margin="0,0,4,0"/>
