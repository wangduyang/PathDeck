<Window x:Class="QuickFileDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickFileDesk"
        Title="PathDeck" Icon="PathDeck.ico" Width="1260" Height="780" MinWidth="880" MinHeight="490"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Loaded="Start" Closing="CheckClose" Closed="Stop" PreviewKeyDown="Shortcuts"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:FileAgeConverter x:Key="FileAgeConverter"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fill" Property="Opacity" Value=".38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value=".86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PathButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PathArrow" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Background" Value="{DynamicResource OverviewTile}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="Normal">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Grid>
                                    <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                    </Border>
                                    <Thumb x:Name="PART_HeaderGripper" Width="8" HorizontalAlignment="Right" Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent">
                                                    <Border Width="1" HorizontalAlignment="Right" Margin="0,8,0,8"
                                                            Background="{DynamicResource Edge}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource Hover}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource Selected}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="Padding">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="MinHeight" Value="{DynamicResource FileRowHeight}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource RowDivider}" BorderThickness="0,0,0,1"
                                Padding="0,4" SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusEdge}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="MaxWidth" Value="235"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBackground" Background="Transparent" CornerRadius="8" MinHeight="30"
                                BorderBrush="Transparent" BorderThickness="1" Margin="0,0,5,5" Padding="10,4,5,4">
                            <DockPanel>
                                <Ellipse x:Name="TabSelectionDot" DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource IdleDot}"
                                         VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="TabBackground" Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/>
                                <Setter TargetName="TabSelectionDot" Property="Fill" Value="{DynamicResource ActiveDot}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LocationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Padding="9,7" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarCardSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#283B4D" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity=".11"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="FileIcon">
            <Grid Width="26" Height="26">
                <Viewbox x:Name="Paper">
                    <Canvas Width="26" Height="26">
                        <Path Data="M 5,3 Q 5,1.5 6.5,1.5 L 15,1.5 21,7.5 21,22 Q 21,24 19,24 L 7,24 Q 5,24 5,22 Z"
                              StrokeThickness="1.2" StrokeLineJoin="Round">
                            <Path.Fill><SolidColorBrush Color="{Binding IconColor}" Opacity=".12"/></Path.Fill>
                            <Path.Stroke><SolidColorBrush Color="{Binding IconColor}"/></Path.Stroke>
                        </Path>
                        <Path Data="M 15,2 L 15,7.5 20.5,7.5 Z" StrokeThickness=".8">
                            <Path.Fill><SolidColorBrush Color="{Binding IconColor}" Opacity=".27"/></Path.Fill>
                            <Path.Stroke><SolidColorBrush Color="{Binding IconColor}"/></Path.Stroke>
                        </Path>
                        <Path Data="M 8.5,12 L 17.5,12 M 8.5,15.5 L 17.5,15.5 M 8.5,19 L 14.5,19"
                              StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Stroke><SolidColorBrush Color="{Binding IconColor}"/></Path.Stroke>
                        </Path>
                    </Canvas>
                </Viewbox>
                <Viewbox x:Name="Photo" Visibility="Collapsed">
                    <Canvas Width="26" Height="26">
                        <Rectangle Canvas.Left="2" Canvas.Top="3.5" Width="22" Height="19" RadiusX="4" RadiusY="4" StrokeThickness="1.2">
                            <Rectangle.Fill><SolidColorBrush Color="{Binding IconColor}" Opacity=".14"/></Rectangle.Fill>
                            <Rectangle.Stroke><SolidColorBrush Color="{Binding IconColor}"/></Rectangle.Stroke>
                        </Rectangle>
                        <Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Fill="#FBB645"/>
                        <Path Data="M 4,19 L 10,13.5 13,16 18.5,10.5 22,14.4 22,19 Q 22,20.5 20.5,20.5 L 5.5,20.5 Q 4,20.5 4,19 Z"
                              StrokeLineJoin="Round">
                            <Path.Fill><SolidColorBrush Color="{Binding IconColor}"/></Path.Fill>
                        </Path>
                    </Canvas>
                </Viewbox>
                <Viewbox x:Name="Folder" Visibility="Collapsed">
                    <Canvas Width="26" Height="26">
                        <Path Data="M 2,7 Q 2,4 5,4 L 10,4 Q 11.2,4 12,5 L 13.1,6.3 21,6.3 Q 24,6.3 24,9.3 L 24,19 Q 24,22 21,22 L 5,22 Q 2,22 2,19 Z"
                              Fill="{DynamicResource FolderBack}"/>
                        <Rectangle Canvas.Left="2" Canvas.Top="8.2" Width="22" Height="14" RadiusX="3.1" RadiusY="3.1">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{DynamicResource FolderTop}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource FolderBottom}" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="Paper" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Folder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter TargetName="Paper" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Photo" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1">
            <Grid Margin="12,10,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="242"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="1" HorizontalAlignment="Left" KeyboardNavigation.TabNavigation="Local">
                    <Button x:Name="NewTabButton" DockPanel.Dock="Right" Content="＋" ToolTip="新建标签页 (Ctrl+T)"
                            AutomationProperties.Name="新建标签页" Click="NewTabClick" Margin="4,0,0,5"
                            Width="34" Height="30" Padding="3" VerticalAlignment="Top" TabIndex="1"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" TabIndex="0">
                        <TabControl x:Name="Tabs" SelectionChanged="ChangeTab" Background="Transparent" BorderThickness="0">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <TabPanel IsItemsHost="True"/>
                                </ControlTemplate>
                            </TabControl.Template>
                        </TabControl>
                    </ScrollViewer>
                </DockPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,5">
                    <Button x:Name="QuickSearchButton" Height="30" Click="QuickSearchClick" Style="{StaticResource PrimaryActionButton}"
                            ToolTip="搜索各磁盘中已建立索引的位置" AutomationProperties.Name="跨盘搜索">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                            <TextBlock Text="跨盘搜索" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Content="&#xE713;" Click="OpenSettings" Width="34" Height="30" Padding="3"
                            Margin="4,0,0,0" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="设置" ToolTip="设置"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="242"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,13,12,12" LastChildFill="True">
                    <Grid DockPanel.Dock="Bottom" Margin="4,8,4,3">
                        <Border Style="{StaticResource SidebarCardSurface}"/>
                        <Grid Margin="7,8,7,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="6,0,0,8">
                                <Button DockPanel.Dock="Right" Content="＋" ToolTip="固定当前文件夹"
                                        AutomationProperties.Name="固定当前文件夹" Click="PinCurrentClick" Width="29" Height="26" Padding="2"/>
                                <TextBlock Text="经常访问" Style="{StaticResource SidebarSectionTitle}"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PinsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="4,3,4,9">
                                <Border Style="{StaticResource SidebarCardSurface}"/>
                                <StackPanel Margin="6,7">
                                    <TextBlock Text="常用位置" Style="{StaticResource SidebarSectionTitle}" Margin="7,3,0,5"/>
                                    <StackPanel x:Name="PlacesPanel"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="4,0,4,8">
                                <Border Style="{StaticResource SidebarCardSurface}"/>
                                <StackPanel Margin="6,7">
                                    <TextBlock Text="驱动器" Style="{StaticResource SidebarSectionTitle}" Margin="7,3,0,5"/>
                                    <ItemsControl x:Name="SidebarDrives">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LocationButton}" Background="Transparent" Click="OpenSidebarDrive"
                                                        ToolTip="{Binding CapacityText}" AutomationProperties.Name="{Binding Label}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" Width="34" Margin="6,0,0,0"
                                                                   TextAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                                        <ProgressBar DockPanel.Dock="Right" Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                                                     Width="42" Height="11" IsHitTestVisible="False" AutomationProperties.Name="已用容量">
                                                            <ProgressBar.Template>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <DockPanel>
                                                                        <Border DockPanel.Dock="Right" Width="2" Height="5" CornerRadius="0,1,1,0"
                                                                                Background="{DynamicResource GaugeOutline}" VerticalAlignment="Center"/>
                                                                        <Border BorderBrush="{DynamicResource GaugeOutline}" BorderThickness="1" Padding="1" CornerRadius="3" Background="{DynamicResource GaugeTrack}">
                                                                            <Grid x:Name="PART_Track">
                                                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1.5"
                                                                                        Background="{DynamicResource Accent}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DockPanel>
                                                                </ControlTemplate>
                                                            </ProgressBar.Template>
                                                        </ProgressBar>
                                                        <TextBlock DockPanel.Dock="Left" Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"
                                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid x:Name="FolderPage" Grid.Column="1" Margin="14,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Panel}" CornerRadius="10" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackButton" Content="&#xE72B;" ToolTip="后退 (Alt+←)" AutomationProperties.Name="后退"
                                    Click="BackClick" Width="32" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}"/>
                            <Button x:Name="ForwardButton" Content="&#xE72A;" ToolTip="前进 (Alt+→)" AutomationProperties.Name="前进"
                                    Click="ForwardClick" Width="32" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}"/>
                            <Button x:Name="UpButton" Content="&#xE70E;" ToolTip="上一级 (Alt+↑)" AutomationProperties.Name="上一级"
                                    Click="UpClick" Width="32" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}"/>
                            <Button Content="&#xE72C;" ToolTip="刷新 (F5)" AutomationProperties.Name="刷新"
                                    Click="RefreshClick" Width="32" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="8,0" Padding="4,2" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{DynamicResource Edge}" Background="{DynamicResource Field}">
                        <Grid>
                            <Grid x:Name="AddressTrail">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"
                                           FontSize="14" VerticalAlignment="Center" Margin="7,0,4,0"/>
                                <Grid x:Name="BreadcrumbViewport" Grid.Column="1" ClipToBounds="True" SizeChanged="BreadcrumbSizeChanged">
                                    <Button Focusable="False" Click="EditAddressClick" Style="{StaticResource ToolbarButton}" ToolTip="点击空白处输入路径"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="BreadcrumbMore" Content="…" AutomationProperties.Name="上级路径"
                                                ToolTip="显示上级路径" Style="{StaticResource PathButton}" Visibility="Collapsed"
                                                Click="OpenHiddenBreadcrumbs"/>
                                        <StackPanel x:Name="BreadcrumbItems" Orientation="Horizontal"/>
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Column="2" Content="&#xE70F;" Width="30" Click="EditAddressClick" ToolTip="输入路径 (Ctrl+L)"
                                        AutomationProperties.Name="编辑路径" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}"/>
                            </Grid>
                            <TextBox x:Name="AddressBox" Visibility="Collapsed" AutomationProperties.Name="地址栏"
                                     Background="Transparent" BorderThickness="0" ToolTip="回车打开，Esc 取消"
                                     KeyDown="AddressKey" LostKeyboardFocus="AddressLostFocus"/>
                        </Grid>
                    </Border>
                    <Border x:Name="FolderSearch" Grid.Column="2" Width="194" CornerRadius="7" Padding="3,2" BorderThickness="1"
                            BorderBrush="{DynamicResource Edge}" Background="{DynamicResource Field}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#xE721;" AutomationProperties.Name="搜索当前目录" ToolTip="搜索当前目录及子目录 (Ctrl+F)"
                                    FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Click="SearchClick" Width="28"/>
                            <Grid>
                                <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索当前目录及子目录"
                                         ToolTip="搜索当前目录及子目录" Background="Transparent" BorderThickness="0" KeyDown="SearchKey"/>
                                <TextBlock x:Name="FolderSearchHint" Text="搜索当前目录" Foreground="{DynamicResource Muted}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                    <CheckBox DockPanel.Dock="Right" Content="隐藏文件" ToolTip="勾选后显示隐藏文件和系统文件" x:Name="HiddenToggle"
                              Foreground="{DynamicResource Muted}" VerticalContentAlignment="Center" Click="HiddenClick"/>
