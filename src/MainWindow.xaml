                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="视图" Margin="5,0,5,0"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="8" VerticalAlignment="Center"/>
