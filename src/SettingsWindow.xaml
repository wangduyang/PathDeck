<Window x:Class="QuickFileDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:QuickFileDesk"
        Title="PathDeck · 文件管理设置" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13"
        Loaded="ReadSettings">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,7"/>
        </Style>
        <Style x:Key="StartupSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchTrack" Background="{DynamicResource SwitchTrack}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="14" Padding="2">
                            <Ellipse x:Name="SwitchKnob" Width="22" Height="22" Fill="{DynamicResource SwitchKnob}" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="文件管理设置" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock x:Name="BuildVersionText" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
        <TextBlock Text="颜色、透明度与模糊度自动同步，可在托盘设置中统一调整。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <local:LiquidGlassBorder Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="20" Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="默认文件管理器" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="适用于通过默认方式打开的普通文件夹和驱动器。系统文件对话框保持原生界面，Win+E 可在下方单独设置。"
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,10"/>
                <TextBlock x:Name="DefaultStatus" Foreground="{DynamicResource Accent}" Margin="0,0,0,9"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="EnableDefaultButton" Content="设为默认" Click="EnableDefault" Margin="0,0,8,0"/>
                    <Button x:Name="RestoreDefaultButton" Content="恢复原设置" Click="RestoreDefault"/>
                </StackPanel>
            </StackPanel>
        </local:LiquidGlassBorder>
        <local:LiquidGlassBorder Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="20" Padding="16">
            <DockPanel>
                <CheckBox x:Name="WinEToggle" DockPanel.Dock="Right" Click="ToggleWinE" VerticalAlignment="Center"
                          AutomationProperties.Name="用 Win+E 打开 PathDeck" Style="{StaticResource StartupSwitch}" Margin="10,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="用 Win+E 打开 PathDeck" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="WinEStatus" Text="开启后，关闭窗口时 PathDeck 会留在后台响应 Win+E。"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </local:LiquidGlassBorder>
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="HelpButton" Content="使用说明与演示" Click="OpenHelp" ToolTip="按场景查看详细操作步骤"/>
            <Button Grid.Column="2" Content="自定义右键菜单…" Click="ConfigureFileMenuClick"/>
        </Grid>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorText}" Margin="1,9,0,0" Visibility="Collapsed"/>
        <Button Content="完成" IsCancel="True" Click="CloseSettings" Style="{StaticResource DialogPrimaryButton}"
                HorizontalAlignment="Right" MinWidth="96" MinHeight="38" Margin="0,18,0,0"/>
    </StackPanel>
</Window>

