<Window x:Class="QuickFileDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PathDeck 设置" Width="478" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Loaded="ReadSettings">
    <Window.Resources>
        <Style x:Key="StartupSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="43"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchTrack" Background="{DynamicResource SwitchTrack}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="13" Padding="2">
                            <Ellipse x:Name="SwitchKnob" Width="17" Height="17" Fill="{DynamicResource SwitchKnob}" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Choice" MinWidth="58" Padding="10,5" CornerRadius="6" BorderThickness="1"
                                Background="Transparent" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource FocusEdge}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource Field}" CornerRadius="8" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LightTheme" Content="浅色" GroupName="Appearance" Style="{StaticResource ThemeChoice}" Click="SelectTheme"/>
                        <RadioButton x:Name="DarkTheme" Content="深色" GroupName="Appearance" Style="{StaticResource ThemeChoice}" Click="SelectTheme"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="外观" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="默认文件管理器" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="适用于 Windows 通过默认方式打开的普通文件夹和驱动器。Win+E 和系统文件对话框仍由 Windows 提供。"
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,10"/>
                <TextBlock x:Name="DefaultStatus" Foreground="{DynamicResource Accent}" Margin="0,0,0,9"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="EnableDefaultButton" Content="设为默认" Click="EnableDefault" Margin="0,0,8,0"/>
                    <Button x:Name="RestoreDefaultButton" Content="恢复原设置" Click="RestoreDefault"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10" Padding="14">
            <DockPanel>
                <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Click="ToggleStartup" VerticalAlignment="Center"
                          AutomationProperties.Name="开机启动" Style="{StaticResource StartupSwitch}" Margin="10,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="开机启动" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="StartupStatus" Text="登录 Windows 后打开 PathDeck。"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,10,0,0">
            <DockPanel>
                <CheckBox x:Name="WinEToggle" DockPanel.Dock="Right" Click="ToggleWinE" VerticalAlignment="Center"
                          AutomationProperties.Name="用 Win+E 打开 PathDeck" Style="{StaticResource StartupSwitch}" Margin="10,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="用 Win+E 打开 PathDeck" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="WinEStatus" Text="开启后，关闭窗口时 PathDeck 会留在后台响应 Win+E。"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Button Content="自定义右键菜单…" Click="ConfigureFileMenuClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorText}" Margin="1,9,0,0" Visibility="Collapsed"/>
        <Button Content="完成" IsCancel="True" HorizontalAlignment="Right" MinWidth="72" Margin="0,14,0,0"/>
    </StackPanel>
</Window>

