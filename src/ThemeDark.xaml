<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#292C30"/>
        <GradientStop Offset=".55" Color="#20272A"/>
        <GradientStop Offset="1" Color="#1E2C26"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#7C7B8781"/>
        <GradientStop Offset="1" Color="#3838443E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#A34A5650"/>
        <GradientStop Offset="1" Color="#66344039"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint=".1,0" EndPoint=".7,1">
        <GradientStop Offset="0" Color="#20FFFFFF"/>
        <GradientStop Offset=".42" Color="#00FFFFFF"/>
        <GradientStop Offset="1" Color="#0CFFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PopupGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F03C4842"/>
        <GradientStop Offset="1" Color="#EB28372F"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Chrome">#482D3033</SolidColorBrush>
    <SolidColorBrush x:Key="Panel">#A62B3430</SolidColorBrush>
    <SolidColorBrush x:Key="OverviewTile">#80383E3F</SolidColorBrush>
    <SolidColorBrush x:Key="Sidebar">#00FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarCard">#EE2D3133</SolidColorBrush>
    <SolidColorBrush x:Key="Field">#78434D47</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarSurface">#80353D3E</SolidColorBrush>
    <SolidColorBrush x:Key="Edge">#484C5555</SolidColorBrush>
    <SolidColorBrush x:Key="RowDivider">#553D4746</SolidColorBrush>
    <SolidColorBrush x:Key="Text">#F0F3F1</SolidColorBrush>
    <SolidColorBrush x:Key="Muted">#ADB9B5</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#9EDCC5</SolidColorBrush>
    <SolidColorBrush x:Key="FocusEdge">#70B79D</SolidColorBrush>
    <SolidColorBrush x:Key="Selected">#35574B</SolidColorBrush>
    <SolidColorBrush x:Key="Hover">#80424E49</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonSurface">#80424D47</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonEdge">#70616F68</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonHover">#4B5C53</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryFill">#A4DBC4</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryHover">#C1EBD9</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryText">#163C2D</SolidColorBrush>
    <LinearGradientBrush x:Key="SearchSurface" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#2B2E31"/>
        <GradientStop Offset="1" Color="#304039"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GaugeTrack">#384840</SolidColorBrush>
    <SolidColorBrush x:Key="GaugeOutline">#849B8B</SolidColorBrush>
    <SolidColorBrush x:Key="Grip">#4F675B</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollThumb">#647D6F</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollHover">#88A191</SolidColorBrush>
    <SolidColorBrush x:Key="SwitchTrack">#4B6155</SolidColorBrush>
    <SolidColorBrush x:Key="IdleDot">#81958B</SolidColorBrush>
    <SolidColorBrush x:Key="ActiveDot">#A4E1C6</SolidColorBrush>
    <SolidColorBrush x:Key="AgeRecentBackground">#48302E</SolidColorBrush>
    <SolidColorBrush x:Key="AgeRecentText">#FFAD94</SolidColorBrush>
    <SolidColorBrush x:Key="AgeDayBackground">#433920</SolidColorBrush>
    <SolidColorBrush x:Key="AgeDayText">#F5C675</SolidColorBrush>
    <SolidColorBrush x:Key="AgeWeekBackground">#263C31</SolidColorBrush>
    <SolidColorBrush x:Key="AgeWeekText">#ADE4B1</SolidColorBrush>
    <SolidColorBrush x:Key="AgeMonthBackground">#253951</SolidColorBrush>
    <SolidColorBrush x:Key="AgeMonthText">#A5CAF5</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorText">#FF9493</SolidColorBrush>
    <SolidColorBrush x:Key="IconBlue">#8DB8FF</SolidColorBrush>
    <SolidColorBrush x:Key="IconTeal">#69D6D0</SolidColorBrush>
    <SolidColorBrush x:Key="IconViolet">#B7A6FF</SolidColorBrush>
    <SolidColorBrush x:Key="IconRed">#F88E8E</SolidColorBrush>
    <SolidColorBrush x:Key="IconGold">#F4C76A</SolidColorBrush>
