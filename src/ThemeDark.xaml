    <SolidColorBrush x:Key="SwitchKnob">#F4FFFB</SolidColorBrush>
    <Color x:Key="FolderTop">#A6E5C9</Color>
    <Color x:Key="FolderBottom">#68BD9F</Color>

    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}">#2B2E31</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}">#F0F3F1</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}">#2B2E31</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}">#F0F3F1</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}">#30383A</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}">#F0F3F1</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}">#35574B</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}">#F0F3F1</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}">#34413B</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}">#F0F3F1</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}">#ADB9B5</SolidColorBrush>
</ResourceDictionary>
