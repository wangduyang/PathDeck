<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F2F2EF"/>
        <GradientStop Offset=".55" Color="#EDF2F2"/>
        <GradientStop Offset="1" Color="#E3EDE7"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#C4FFFFFF"/>
        <GradientStop Offset="1" Color="#B8CAD5CF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#C4FFFFFF"/>
        <GradientStop Offset="1" Color="#66FFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheen" StartPoint=".1,0" EndPoint=".7,1">
        <GradientStop Offset="0" Color="#60FFFFFF"/>
        <GradientStop Offset=".42" Color="#08FFFFFF"/>
        <GradientStop Offset="1" Color="#1AFFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PopupGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#EEFFFFFF"/>
        <GradientStop Offset="1" Color="#E0EEF5F0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Chrome">#52FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Panel">#B8FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="OverviewTile">#69E6EBE9</SolidColorBrush>
    <SolidColorBrush x:Key="Sidebar">#00FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarCard">#ECFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Field">#70FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarSurface">#70FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Edge">#C4D7DDDA</SolidColorBrush>
    <SolidColorBrush x:Key="RowDivider">#64DCE3DF</SolidColorBrush>
    <SolidColorBrush x:Key="Text">#222728</SolidColorBrush>
    <SolidColorBrush x:Key="Muted">#636D70</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#167563</SolidColorBrush>
    <SolidColorBrush x:Key="FocusEdge">#359A85</SolidColorBrush>
    <SolidColorBrush x:Key="Selected">#D1EDE4</SolidColorBrush>
    <SolidColorBrush x:Key="Hover">#8FE7EFEB</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonSurface">#8FFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonEdge">#D4DBDFDC</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonHover">#E5F1EC</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryFill">#247B68</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryHover">#1A6555</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryText">#FFFFFF</SolidColorBrush>
    <LinearGradientBrush x:Key="SearchSurface" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFFFFF"/>
        <GradientStop Offset="1" Color="#E3F0EA"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GaugeTrack">#DCE6E0</SolidColorBrush>
    <SolidColorBrush x:Key="GaugeOutline">#94A69B</SolidColorBrush>
    <SolidColorBrush x:Key="Grip">#BCCBC3</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollThumb">#9AACA2</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollHover">#778D81</SolidColorBrush>
    <SolidColorBrush x:Key="SwitchTrack">#CAD5CF</SolidColorBrush>
    <SolidColorBrush x:Key="IdleDot">#96A29B</SolidColorBrush>
    <SolidColorBrush x:Key="ActiveDot">#219876</SolidColorBrush>
    <SolidColorBrush x:Key="AgeRecentBackground">#FAEAE3</SolidColorBrush>
    <SolidColorBrush x:Key="AgeRecentText">#913E32</SolidColorBrush>
    <SolidColorBrush x:Key="AgeDayBackground">#FCF0D4</SolidColorBrush>
    <SolidColorBrush x:Key="AgeDayText">#785115</SolidColorBrush>
    <SolidColorBrush x:Key="AgeWeekBackground">#E4F1E4</SolidColorBrush>
    <SolidColorBrush x:Key="AgeWeekText">#326245</SolidColorBrush>
    <SolidColorBrush x:Key="AgeMonthBackground">#E7F0FA</SolidColorBrush>
    <SolidColorBrush x:Key="AgeMonthText">#365D83</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorText">#A52B2B</SolidColorBrush>
    <SolidColorBrush x:Key="IconBlue">#4169E1</SolidColorBrush>
    <SolidColorBrush x:Key="IconTeal">#008B8B</SolidColorBrush>
    <SolidColorBrush x:Key="IconViolet">#483D8B</SolidColorBrush>
    <SolidColorBrush x:Key="IconRed">#B22222</SolidColorBrush>
    <SolidColorBrush x:Key="IconGold">#B8860B</SolidColorBrush>
    <SolidColorBrush x:Key="IconGreen">#2E8B57</SolidColorBrush>
    <SolidColorBrush x:Key="IconSlate">#708090</SolidColorBrush>
    <SolidColorBrush x:Key="FolderBack">#327C66</SolidColorBrush>
    <SolidColorBrush x:Key="SwitchKnob">#FFFFFF</SolidColorBrush>
    <Color x:Key="FolderTop">#89D4BC</Color>
    <Color x:Key="FolderBottom">#45A184</Color>

    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}">#222728</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}">#222728</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}">#F2F5F3</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}">#222728</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}">#D1EDE4</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}">#222728</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}">#EBF2EE</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}">#222728</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}">#636D70</SolidColorBrush>
</ResourceDictionary>
